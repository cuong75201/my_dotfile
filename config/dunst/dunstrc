[global]

font = "JetBrainsMono Nerd Font 10"

width = (0,300)
height = (0, 300)
origin = top-right
offset = (20, 30)

separator_height = 2
padding = 10
horizontal_padding = 10
frame_width = 2

background = "#000"
mouse_left_click = do_action
mouse_middle_click = close_current
mouse_right_click = close_all

markup = full


[urgency_low]

frame_color = "#3B7C87"
foreground = "#3B7C87"
background = "#191311"
timeout = 4

[urgency_normal]
frame_color = "#5B8234"
foreground = "#5B8234"
background = "#191311"
#background = "#2B313C"
timeout = 6

[urgency_critical]
frame_color = "#B7472A"
foreground = "#B7472A"
background = "#191311"
#background = "#2B313C"
timeout = 8
